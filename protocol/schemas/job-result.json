{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/job-result.json",
  "title": "job.result body (PROTOCOL 4.4)",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "result": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "status": {
              "enum": [
                "succeeded",
                "failed"
              ]
            },
            "duration_ms": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "xcode": {
              "type": "string"
            },
            "destination": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "error_count": {
              "type": "integer",
              "minimum": 0
            },
            "warning_count": {
              "type": "integer",
              "minimum": 0
            },
            "errors": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^(<sdk>|<outside>|[^/\\u0000-\\u001f][^\\u0000-\\u001f]*)$"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "message",
                  "type"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "warnings": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "file": {
                    "type": "string",
                    "maxLength": 500,
                    "pattern": "^(<sdk>|<outside>|[^/\\u0000-\\u001f][^\\u0000-\\u001f]*)$"
                  },
                  "line": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "column": {
                    "type": "integer",
                    "minimum": 0
                  },
                  "message": {
                    "type": "string",
                    "maxLength": 500
                  },
                  "type": {
                    "type": "string",
                    "maxLength": 100
                  }
                },
                "required": [
                  "message",
                  "type"
                ],
                "additionalProperties": false
              },
              "maxItems": 50
            },
            "log_tail": {
              "type": "string",
              "maxLength": 4000
            },
            "truncated": {
              "type": "boolean"
            }
          },
          "required": [
            "destination",
            "duration_ms",
            "error_count",
            "errors",
            "log_tail",
            "status",
            "truncated",
            "warning_count",
            "warnings",
            "xcode"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "mime": {
              "const": "image/png"
            },
            "width": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "height": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2000
            },
            "display": {
              "type": "integer",
              "minimum": 1
            },
            "png_b64": {
              "type": "string",
              "maxLength": 12582912
            }
          },
          "required": [
            "display",
            "height",
            "mime",
            "png_b64",
            "width"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "os_version": {
              "type": "string",
              "maxLength": 32
            },
            "os_build": {
              "type": "string",
              "maxLength": 32
            },
            "arch": {
              "enum": [
                "arm64",
                "x86_64"
              ]
            },
            "cpu": {
              "type": "string",
              "maxLength": 100
            },
            "memory_gb": {
              "type": "integer",
              "minimum": 0
            },
            "xcode": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "properties": {
                    "version": {
                      "type": "string",
                      "maxLength": 32
                    },
                    "build": {
                      "type": "string",
                      "maxLength": 32
                    }
                  },
                  "required": [
                    "build",
                    "version"
                  ],
                  "additionalProperties": false
                }
              ]
            },
            "disk_free_gb": {
              "type": "integer",
              "minimum": 0
            }
          },
          "required": [
            "arch",
            "cpu",
            "disk_free_gb",
            "memory_gb",
            "os_build",
            "os_version",
            "xcode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "error": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "$ref": "error.json"
        }
      ]
    }
  },
  "required": [
    "error",
    "job_id",
    "result",
    "state"
  ],
  "additionalProperties": false
}
