{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/auth-ok.json",
  "title": "auth_ok body",
  "type": "object",
  "properties": {
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "server_sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    },
    "server_time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    }
  },
  "required": [
    "server_sig",
    "server_time_ms",
    "sid"
  ],
  "additionalProperties": false
}
