{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/payload-handshake.json",
  "title": "Decoded payload of an unsigned handshake envelope: hello, auth, auth_ok, pair, pair_ok, error (PROTOCOL 2.1).",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "re": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "id",
    "ts",
    "body"
  ],
  "additionalProperties": false
}
