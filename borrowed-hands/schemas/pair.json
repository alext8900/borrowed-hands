{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/pair.json",
  "title": "pair body (PROTOCOL 3.3)",
  "type": "object",
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{22}$"
    },
    "device_pubkey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "device_name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_][A-Za-z0-9 ._+-]{0,63}$"
    },
    "client_nonce": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "helper_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "os": {
      "const": "macos"
    },
    "os_version": {
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+){0,3}$"
    },
    "arch": {
      "enum": [
        "arm64",
        "x86_64"
      ]
    },
    "pair_sig": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "arch",
    "client_nonce",
    "code",
    "device_name",
    "device_pubkey",
    "helper_version",
    "os",
    "os_version",
    "pair_sig"
  ],
  "additionalProperties": false
}
