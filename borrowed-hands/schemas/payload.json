{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/payload.json",
  "title": "Decoded payload of a signed envelope, every frame after auth_ok/pair_ok (PROTOCOL 2.3). Also enforce exp - ts <= 120000 and now <= exp + 60000 (not expressible here).",
  "type": "object",
  "properties": {
    "type": {
      "type": "string",
      "pattern": "^[a-z_]+(\\.[a-z_]+)?$"
    },
    "id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "re": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "sid": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "seq": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "ts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "exp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "body": {
      "type": "object"
    }
  },
  "required": [
    "type",
    "id",
    "sid",
    "seq",
    "ts",
    "exp",
    "body"
  ],
  "additionalProperties": false
}
