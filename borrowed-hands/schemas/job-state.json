{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/job-state.json",
  "title": "job.accepted / job.state body",
  "type": "object",
  "properties": {
    "job_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-4[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "state": {
      "enum": [
        "received",
        "queued",
        "materializing",
        "building",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ]
    },
    "at": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "position": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "job_id",
    "state",
    "at"
  ],
  "additionalProperties": false
}
