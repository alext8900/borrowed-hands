{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://borrowed-hands.dev/protocol/v1/server-rotate.json",
  "title": "server.rotate body",
  "type": "object",
  "properties": {
    "new_pubkey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{43}$"
    },
    "new_key_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{16}$"
    },
    "sig_new": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{86}$"
    }
  },
  "required": [
    "new_key_id",
    "new_pubkey",
    "sig_new"
  ],
  "additionalProperties": false
}
